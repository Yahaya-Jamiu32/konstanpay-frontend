# "mock" = in-browser simulated data (no backend). "live" = real backend.
VITE_API_MODE=mock
# Base URL of the REST API. Use /api with the dev proxy, or a full URL in production.
VITE_API_BASE_URL=/api
# Dev-only proxy target for /api (used by vite.config.js)
DEV_API_PROXY_TARGET=http://localhost:4000
# NEVER put secrets in VITE_* variables: they are bundled into public JavaScript.

# Staging only: allow a production build to run on the built-in mock data (no real backend).
# On Vercel set this for the *Preview* environment only. Never for Production.
# VITE_ALLOW_MOCK=true
