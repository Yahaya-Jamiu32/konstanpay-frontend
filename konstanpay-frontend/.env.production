# ============================================================
# STAGING BUILD SETTINGS  (the app runs on the built-in test data)
# ------------------------------------------------------------
# Lets the Vercel deploy open and work with NO dashboard settings.
# BEFORE GOING LIVE TO REAL USERS change this file to:
#     VITE_API_MODE=live
#     VITE_API_BASE_URL=/api
# and delete the VITE_ALLOW_MOCK line. (Variables set in the Vercel
# dashboard override this file.) See docs/DEPLOY.md.
# ============================================================
VITE_API_MODE=mock
VITE_ALLOW_MOCK=true
VITE_API_BASE_URL=/api
